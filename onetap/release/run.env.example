# PhiTogether 集成服务配置（部署配置，绝不进入模块包或浏览器）。
# PT_ONETAP_SERVICE_KEY 必须换成 ≥32 字符随机值，且与 OneTap 侧 /opt/onetap/app/env.conf 一致。
PT_ONETAP_INTEGRATION=1
PT_ONETAP_SERVICE_KEY=change-me-to-a-random-secret-of-32-plus-chars
PT_DATA_DIR=/home/maple/phitogether/data
PT_ONETAP_DB=/home/maple/phitogether/data/phitogether-onetap.db
PT_HOST=127.0.0.1
PT_PORT=8271
